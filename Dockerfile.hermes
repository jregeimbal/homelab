FROM nousresearch/hermes-agent:main

USER root

# Install packages using system python3
RUN apt-get update && apt-get install -y --no-install-recommends python3-pip && \
    python3 -m pip install --target=/opt/hermes/.venv/lib/python3.12/site-packages discord.py python-telegram-bot && \
    apt-get clean && rm -rf /var/lib/apt/lists/*

USER 1000
